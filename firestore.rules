rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'employee']);
      allow write: if request.auth != null && (request.auth.uid == id || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'employee'];
    }
    match /orders/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'employee']);
      allow write: if request.auth != null;
    }
  }
}
